# Pinata IPFS Configuration
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here
PINATA_JWT_SECRET=your_pinata_jwt_token_here
PINATA_GROUP_ID=your_pinata_group_id_here

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth 2.0 (Required for updating video descriptions)
# Generate using: python get_youtube_oauth_token.py
YOUTUBE_OAUTH_TOKEN=your_youtube_oauth_token_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# XRPL Configuration
# For Testnet
XRPL_NODE_URL=https://s.altnet.rippletest.net:51234/
XRPL_SECRET=your_xrpl_wallet_seed_here

# For Mainnet (uncomment when ready for production)
# XRPL_NODE_URL=https://xrplcluster.com/
# XRPL_SECRET=your_xrpl_mainnet_wallet_seed_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=youtube_nft_db

# Optional: Logging Level
LOG_LEVEL=INFO
