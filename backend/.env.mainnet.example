# ========================================
# XRPL MAINNET PRODUCTION CONFIGURATION
# ========================================
#
# ⚠️  WARNING: This is for MAINNET (production)
# Real XRP will be used for transactions
#
# Before using:
# 1. Create mainnet wallet (see MAINNET_DEPLOYMENT.md)
# 2. Fund wallet with 15-20 XRP minimum
# 3. Backup wallet secret securely
# 4. Test on testnet first
#
# ========================================

# ====================
# XRPL Mainnet Configuration
# ====================

# Mainnet Node URL (choose one)
XRPL_NODE_URL=https://xrplcluster.com/
# Alternative: XRPL_NODE_URL=https://s2.ripple.com:51234/
# Alternative: XRPL_NODE_URL=wss://xrplcluster.com/

# Your mainnet wallet secret (KEEP THIS SECURE!)
# Generate with: python3 -c "from xrpl.wallet import Wallet; w = Wallet.create(); print(f'Address: {w.address}\nSecret: {w.seed}')"
XRPL_SECRET=sXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ====================
# Pinata IPFS (Production)
# ====================

# Production Pinata JWT token
# Get from: https://app.pinata.cloud/developers/api-keys
PINATA_JWT_SECRET=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ====================
# YouTube API (Production)
# ====================

# YouTube Data API v3 key (production quota)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# YouTube OAuth token (for description updates)
# Generate with: python3 get_youtube_oauth_token.py
YOUTUBE_OAUTH_TOKEN=ya29.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Refresh token for automatic renewal
YOUTUBE_REFRESH_TOKEN=1//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ====================
# MongoDB (Production Database)
# ====================

# Production MongoDB connection string
# Recommend: Separate cluster from testnet
MONGODB_URI=mongodb+srv://production_user:SECURE_PASSWORD@production-cluster.mongodb.net/?retryWrites=true&w=majority

# Production database name
MONGODB_DB=bcaxrplprod

# ====================
# Network Identifier
# ====================

# Set to "mainnet" for production
NETWORK=mainnet

# ====================
# Optional: Advanced Configuration
# ====================

# Transaction retry settings
# TX_RETRY_COUNT=3
# TX_TIMEOUT=30

# IPFS Gateway (for verification)
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# ====================
# Security Reminders
# ====================
#
# ✅ DO:
# - Keep this file out of version control (.gitignore)
# - Store wallet secret in password manager
# - Backup wallet secret offline
# - Use separate production MongoDB cluster
# - Monitor wallet balance regularly
# - Set up automated alerts for low balance
#
# ❌ DO NOT:
# - Commit this file to git
# - Share wallet secret with anyone
# - Use testnet wallet on mainnet
# - Mix testnet and mainnet databases
# - Use production keys in development
#
# ====================
